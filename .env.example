# AutoParts configuration. Copy to .env.local and fill in real values.
# Never commit a filled-in copy: every secret below is server-only and none of
# them may be given a NEXT_PUBLIC_ prefix.

# --- AgentPay ---------------------------------------------------------------
# Base URL of the AgentPay deployment that serves the public registry
# (/api/registry/agents/:id, /api/registry/keys, /api/registry/mandates/:id,
# POST /api/registry/nonces).
AGENTPAY_REGISTRY_URL=https://agentpay-yuno.vercel.app

# Merchant identity as AgentPay mandates scope it.
AGENTPAY_MERCHANT_ID=mrc_autoparts
AGENTPAY_MERCHANT_NAME=AutoParts

# --- Store quote signing ----------------------------------------------------
# Ed25519 OKP private JWK, as JSON or base64-encoded JSON. Server-only.
# Generate one with:  node scripts/generate-merchant-key.mjs
AGENTPAY_MERCHANT_PRIVATE_JWK=
AGENTPAY_MERCHANT_KEY_ID=autoparts-quote-key-1

# --- Store ------------------------------------------------------------------
# Absolute origin this store is served from.
AUTOPARTS_PUBLIC_ORIGIN=http://localhost:3300
AUTOPARTS_QUOTE_TTL_SECONDS=900

# memory is development/test only. Production must be durable, and DATABASE_URL
# becomes required; the service refuses to start otherwise.
AUTOPARTS_PERSISTENCE=memory
DATABASE_URL=

# --- Browser demo checkout (local only) -------------------------------------
# Lets the storefront drive a purchase from the browser by signing the request
# server-side with the SDK. This is a demonstration aid, not authentication:
# the service refuses to start with it enabled when NODE_ENV=production.
# The agent id and key must belong to an agent registered in AgentPay.
AUTOPARTS_DEMO_AGENT_ENABLED=false
AUTOPARTS_DEMO_AGENT_ID=
AUTOPARTS_DEMO_AGENT_PRIVATE_KEY=
