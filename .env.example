AGENTPAY_MANDATE_API_URL=https://agentpay-yuno.vercel.app
# The Control Plane's registered ES256 agent-key and atomic replay-claim APIs.
# This may be the Mandate API origin in a single deployment.
AGENTPAY_REQUEST_PROOF_REGISTRY_URL=https://agentpay-yuno.vercel.app
AGENTPAY_MERCHANT_ID=mrc_autoparts
AGENTPAY_MERCHANT_NAME=AutoParts B2B Fleet Supply

# Server-only ES256 quote signing key. Development uses an ephemeral key if empty.
# Never expose private key material with a NEXT_PUBLIC_ prefix.
AGENTPAY_MERCHANT_PRIVATE_JWK=
AGENTPAY_MERCHANT_KEY_ID=

# Server-only merchant service key. It signs the merchant-to-Mandate handoff.
AGENTPAY_MERCHANT_SERVICE_PRIVATE_JWK=
AGENTPAY_MERCHANT_SERVICE_KEY_ID=

# Pinned public JWK used to verify the Mandate service's settlement receipt.
AGENTPAY_MANDATE_RECEIPT_PUBLIC_JWK=
